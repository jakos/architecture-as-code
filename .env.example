# Container engine used by `just` recipes: podman (default) or docker
CONTAINER_ENGINE=podman

# B1 editor PoC (just editor-up): add these variables to .env with your own values, never commit them.
#   PASSWORD        login password of the editor page (code-server or model editor; choose one)
#   MODEL_USER      lowercase name; used in the branch model/<user>/<date>-<slug>
#   MODEL_SLUG      short lowercase description of the change, e.g. add-notifications
#   SPARSE_EXCLUDE  optional, space-separated paths left out of the clone
