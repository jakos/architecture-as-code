views {
  view PaymentsContext of payments {
    title 'Payments / Payments context'
    include payments, * <-> payments
  }

  view PaymentsContainers of payments {
    title 'Payments / Payments containers'
    include *
  }

  view PaymentsComponents of payments.paymentApi {
    title 'Payments / Payments components'
    include *
  }
}
