specification {
  element person
  element softwareSystem
  element container
  deploymentNode environment
  deploymentNode node
  tag external
}

model {
  customer = person 'Customer' {
    description 'Buys products online.'
  }

  shop = softwareSystem 'Shop' {
    description 'Lets customers browse and order products.'

    web = container 'Web Frontend' {
      description 'Serves the shop UI.'
      technology 'TypeScript, Next.js'
      style {
        shape browser
      }
    }
    api = container 'Order API' {
      description 'Accepts and tracks orders.'
      technology 'Python, FastAPI'
    }
    worker = container 'Fulfilment Worker' {
      description 'Consumes order events and ships orders.'
      technology 'Python'
    }
    db = container 'Order Database' {
      description 'Stores orders.'
      technology 'PostgreSQL'
      style {
        shape storage
      }
    }
    events = container 'Order Events' {
      description 'Order lifecycle events.'
      technology 'Kafka topic'
      style {
        shape queue
      }
    }
  }

  payments = softwareSystem 'Payment Provider' {
    #external
    description 'External card payments.'
  }

  customer -> shop.web 'Browses and orders using' 'HTTPS'
  shop.web -> shop.api 'Places orders via' 'JSON/HTTPS'
  shop.api -> shop.db 'Reads and writes' 'SQL'
  shop.api -> shop.events 'Publishes OrderPlaced to' 'Kafka'
  shop.worker -> shop.events 'Consumes OrderPlaced from' 'Kafka'
  shop.api -> payments 'Charges cards via' 'HTTPS'
}

deployment {
  localKind = environment 'local-kind' {
    cluster = node 'kind cluster' {
      description 'Local Kubernetes in containers.'
      technology 'kind'

      shopNamespace = node 'shop' {
        technology 'Kubernetes Namespace'
        metadata {
          kubernetes_namespace 'shop'
        }

        web = instanceOf shop.web {
          metadata {
            kubernetes_kind 'Deployment'
            kubernetes_name 'shop-web'
          }
        }
        api = instanceOf shop.api {
          metadata {
            kubernetes_kind 'Deployment'
            kubernetes_name 'shop-api'
          }
        }
        worker = instanceOf shop.worker {
          metadata {
            kubernetes_kind 'Deployment'
            kubernetes_name 'shop-worker'
          }
        }
        db = instanceOf shop.db {
          metadata {
            kubernetes_kind 'StatefulSet'
            kubernetes_name 'shop-db'
          }
        }
      }
    }
  }
}

views {
  view SystemContext of shop {
    title 'System context'
    include *
  }

  view Containers of shop {
    title 'Containers'
    include *
  }

  deployment view LocalDeployment {
    title 'Local deployment'
    include localKind.**
  }
}
