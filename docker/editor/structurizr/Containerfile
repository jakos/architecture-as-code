# B1 editor, Structurizr variant (local PoC): code-server + `structurizr local` + `submit`.
# Build from the repo root: just editor-build  (context = repo root, see docker/compose.editor.yml)
# Licences: code-server MIT; Structurizr (war) Apache-2.0; OpenJDK GPL-2.0 with Classpath
# Exception (Debian package); vscode-structurizr extension: see docs/research/likec4-trial-poc.md.

# The Structurizr war is taken from the pinned vNext image (same version as
# tools/validate_workspaces.py and docker/compose.yml; bump together). That image is
# Alpine/musl and has no shell, so only the war is copied and a Debian JRE runs it.
FROM docker.io/structurizr/structurizr:2026.09.19 AS structurizr

FROM docker.io/codercom/code-server:4.141.0-trixie

USER root
# apt packages are not version-pinned: they come from the Debian trixie archive at build time.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 openjdk-21-jre-headless \
    && rm -rf /var/lib/apt/lists/*

COPY --from=structurizr /usr/local/structurizr.war /usr/local/lib/structurizr/structurizr.war
RUN printf '%s\n' '#!/bin/sh' \
      'exec java -Dio.netty.noUnsafe=true --enable-native-access=ALL-UNNAMED -Dserver.port="${PORT:-8081}" -jar /usr/local/lib/structurizr/structurizr.war "$@"' \
      > /usr/local/bin/structurizr \
    && printf '%s\n' '#!/bin/sh' \
      'exec python3 /usr/local/lib/poc/submit.py --tool structurizr --path examples/shop --repo /home/coder/model "$@"' \
      > /usr/local/bin/submit \
    && chmod 0755 /usr/local/bin/structurizr /usr/local/bin/submit

COPY tools/submit.py tools/poc_remote.py docker/editor/entrypoint.py /usr/local/lib/poc/

USER coder
# Pinned community extension (Structurizr DSL highlighting) from Open VSX.
RUN code-server --install-extension ciarant.vscode-structurizr@0.0.9

# No password or token here: PASSWORD comes from the environment at run time.
ENV RENDERER=structurizr MODEL_PATH=examples/shop
EXPOSE 8080 8081
ENTRYPOINT ["python3", "/usr/local/lib/poc/entrypoint.py"]
