new file mode 100644
index 0000000..890f9c7
--- /dev/null
+++ b/apps/playground/src/aac/problems.ts
@@ -0,0 +1,107 @@
+import * as monaco from '@codingame/monaco-vscode-editor-api'
+import { atom } from 'nanostores'
+import { errorMessage, type Problem, server, type ToolResult } from './server'
+
+const MARKER_OWNER = 'aac-validate'
+
+export type ProblemsState = {
+  items: Problem[]
+  results: ToolResult[]
+  running: boolean
+  /** null until Validate has run once */
+  ok: boolean | null
+  failure: string | null
+  open: boolean
+  /** File text at the time of validation, to drop problems of files edited since. */
+  validatedTexts: Record<string, string>
+}
+
+export const $problems = atom<ProblemsState>({
+  items: [],
+  results: [],
+  running: false,
+  ok: null,
+  failure: null,
+  open: false,
+  validatedTexts: {},
+})
+
+const markerSeverity = (severity: Problem['severity']) =>
+  severity === 'error'
+    ? monaco.MarkerSeverity.Error
+    : severity === 'warning'
+    ? monaco.MarkerSeverity.Warning
+    : monaco.MarkerSeverity.Info
+
+/** Replaces the markers of this module (the language server's own markers are untouched). */
+export function applyMarkers(items: Problem[]) {
+  const byPath = new Map<string, Problem[]>()
+  for (const item of items) {
+    if (item.path === null) continue
+    byPath.set(item.path, [...(byPath.get(item.path) ?? []), item])
+  }
+  for (const model of monaco.editor.getModels()) {
+    const path = model.uri.path.slice(1)
+    const mine = byPath.get(path) ?? []
+    monaco.editor.setModelMarkers(
+      model,
+      MARKER_OWNER,
+      mine.map(problem => {
+        const line = Math.min(Math.max(problem.line ?? 1, 1), model.getLineCount())
+        return {
+          severity: markerSeverity(problem.severity),
+          message: problem.message,
+          startLineNumber: line,
+          startColumn: problem.column ?? 1,
+          endLineNumber: line,
+          endColumn: problem.column ? problem.column + 1 : model.getLineMaxColumn(line),
+          source: 'likec4 validate',
+        }
+      }),
+    )
+  }
+}
+
+export async function runValidate(files: Record<string, string>) {
+  $problems.set({ ...$problems.get(), running: true, failure: null })
+  try {
+    const result = await server.validate()
+    $problems.set({
+      items: result.problems,
+      results: result.results,
+      running: false,
+      ok: result.ok,
+      failure: null,
+      open: result.problems.length > 0 || !result.ok,
+      validatedTexts: { ...files },
+    })
+    applyMarkers(result.problems)
+  } catch (err) {
+    $problems.set({ ...$problems.get(), running: false, failure: errorMessage(err), open: true })
+  }
+}
+
+/** Forgets problems (and their markers) of files whose text changed since the last validation. */
+export function dropStaleProblems(files: Record<string, string>) {
+  const state = $problems.get()
+  if (state.items.length === 0) return
+  const items = state.items.filter(
+    p => p.path === null || state.validatedTexts[p.path] === files[p.path],
+  )
+  if (items.length === state.items.length) return
+  $problems.set({ ...state, items })
+  applyMarkers(items)
+}
+
+export function revealInEditor(path: string, line: number | null) {
+  const model = monaco.editor.getModel(monaco.Uri.file(path))
+  const editor = monaco.editor.getEditors()[0]
+  if (!model || !editor) return
+  editor.setModel(model)
+  if (line) {
+    const lineNumber = Math.min(line, model.getLineCount())
+    editor.setPosition({ lineNumber, column: 1 })
+    editor.revealLineInCenter(lineNumber)
+  }
+  editor.focus()
+}
