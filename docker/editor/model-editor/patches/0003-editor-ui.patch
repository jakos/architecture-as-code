+import { Anchor, Stack, Text } from '@mantine/core'
+import { DEMO } from './mode'
+
+/** The attribution LikeC4's MIT license asks for; the full text is served next to the app. */
+export function AboutContent() {
+  return (
+    <Stack gap="xs">
+      <Text fz="sm">
+        {DEMO
+          ? 'This is a demo of LikeC4 Model Editor with the example shop model. Your changes stay in this browser tab and are never saved; reloading the page resets the text.'
+          : 'LikeC4 Model Editor edits the LikeC4 model of your team in a git branch. Your changes are saved to the branch on the editor server and go to review when you press Submit.'}
+      </Text>
+      <Text fz="sm" fw={600}>
+        Community project based on LikeC4, not affiliated with it.
+      </Text>
+      <Text fz="sm">
+        It is based on the LikeC4 playground (<Anchor href="https://likec4.dev" target="_blank">likec4.dev</Anchor>),
+        version 1.59.4, with our changes applied as a patch set. LikeC4 is MIT licensed, Copyright (c) 2023-2026 Denis
+        Davydkov.
+      </Text>
+      <Text fz="sm">
+        LikeC4 Model Editor is MIT licensed, Copyright (c) 2026 Jakub Kostrzewa.{' '}
+        <Anchor href={`${import.meta.env.BASE_URL}LICENSE.txt`} target="_blank">License text</Anchor>
+      </Text>
+      <Text fz="sm">
+        <Anchor href={`${import.meta.env.BASE_URL}LICENSE-LikeC4.txt`} target="_blank">LikeC4 license text</Anchor>
+      </Text>
+      <Text fz="sm">
+        <Anchor href={`${import.meta.env.BASE_URL}THIRD-PARTY-NOTICES.txt`} target="_blank">
+          Third-party licence notices
+        </Anchor>
+      </Text>
+    </Stack>
+  )
+}
