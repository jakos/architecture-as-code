+import { usePlayground, usePlaygroundContext } from '$hooks/usePlayground'
+import { ActionIcon, Badge, Button, Group, Text, Tooltip } from '@mantine/core'
+import { modals } from '@mantine/modals'
+import { useStore } from '@nanostores/react'
+import {
+  IconAlertCircle,
+  IconBrandGithub,
+  IconCheck,
+  IconGitBranch,
+  IconInfoCircle,
+  IconLoader2,
+  IconShieldCheck,
+  IconUpload,
+  IconWand,
+} from '@tabler/icons-react'
+import { useEffect, useState } from 'react'
+import { ColorSchemeToggle } from '../components/ColorSchemeToggle'
+import { AboutContent } from './AboutContent'
+import { DEMO } from './mode'
+import { $problems, runValidate } from './problems'
+import { dirtyFiles, saveAll, useSaveStates } from './saving'
+import { errorMessage, server } from './server'
+import { SubmitForm } from './SubmitForm'
+
+function useBranch() {
+  const [branch, setBranch] = useState<string | null>(null)
+  useEffect(() => {
+    if (DEMO) return // no server, no branch
+    server.status().then(s => setBranch(s.branch), () => setBranch(null))
+  }, [])
+  return branch
+}
+
+const overallText = {
+  saved: 'All changes saved',
+  saving: 'Saving...',
+  unsaved: 'Unsaved changes',
+  error: 'Not saved - press Ctrl+S to retry',
+} as const
+
+function SaveIndicator() {
+  const playground = usePlayground()
+  const files = usePlaygroundContext(s => s.files)
+  const { overall, errors } = useSaveStates(files)
+  const firstError = Object.values(errors)[0]
+  const icon = overall === 'saved'
+    ? <IconCheck size={14} color="var(--mantine-color-teal-6)" />
+    : overall === 'error'
+    ? <IconAlertCircle size={14} color="var(--mantine-color-red-6)" />
+    : <IconLoader2 size={14} />
+  return (
+    <Tooltip label={firstError ?? overallText[overall]} withArrow>
+      <Group
+        gap={6}
+        wrap="nowrap"
+        data-testid="save-indicator"
+        data-save-state={overall}
+        style={{ cursor: overall === 'error' ? 'pointer' : 'default' }}
+        onClick={() => overall === 'error' && void saveAll(playground.getContext().files)}>
+        {icon}
+        <Text fz="xs" c={overall === 'error' ? 'red' : 'dimmed'}>{overallText[overall]}</Text>
+      </Group>
+    </Tooltip>
+  )
+}
+
+/**
+ * Ctrl/Cmd+S saves now; leaving the page with unsaved changes asks first.
+ * In the demo Ctrl/Cmd+S only keeps the browser's save dialog away, and leaving never asks:
+ * a reload resets the text, which is the point of the demo.
+ */
+function useSaveShortcuts() {
+  const playground = usePlayground()
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      if ((event.ctrlKey || event.metaKey) && !event.shiftKey && !event.altKey && event.key.toLowerCase() === 's') {
+        event.preventDefault()
+        if (!DEMO) void saveAll(playground.getContext().files)
+      }
+    }
+    const onBeforeUnload = (event: BeforeUnloadEvent) => {
+      if (dirtyFiles(playground.getContext().files).length > 0) {
+        event.preventDefault()
+        event.returnValue = ''
+      }
+    }
+    window.addEventListener('keydown', onKeyDown)
+    if (!DEMO) window.addEventListener('beforeunload', onBeforeUnload)
+    return () => {
+      window.removeEventListener('keydown', onKeyDown)
+      window.removeEventListener('beforeunload', onBeforeUnload)
+    }
+  }, [playground])
+}
+
+export function AacHeader() {
+  const playground = usePlayground()
+  const branch = useBranch()
+  const problems = useStore($problems)
+  const [busy, setBusy] = useState<null | 'format'>(null)
+  const [message, setMessage] = useState<string | null>(null)
+  useSaveShortcuts()
+
+  useEffect(() => {
+    if (!message) return
+    const timer = setTimeout(() => setMessage(null), 5000)
+    return () => clearTimeout(timer)
+  }, [message])
+
+  const validate = async () => {
+    const files = playground.getContext().files
+    if (!(await saveAll(files))) {
+      setMessage('Not validated: some files could not be saved')
+      return
+    }
+    await runValidate(files)
+    const state = $problems.get()
+    setMessage(state.failure ? 'Validate failed' : state.items.length === 0 ? 'No problems found' : null)
+  }
+
+  const format = async () => {
+    setBusy('format')
+    try {
+      if (!(await saveAll(playground.getContext().files))) {
+        setMessage('Not formatted: some files could not be saved')
+        return
+      }
+      const result = await server.format()
+      if (!result.ok) {
+        setMessage('Format failed - see Validate for the problems')
+        return
+      }
+      if (result.changed.length === 0) {
+        setMessage('Already formatted')
+        return
+      }
+      setMessage(`Formatted ${result.changed.length} file(s), reloading`)
+      // The formatted text lives on the server: loading the workspace again is the simplest
+      // way to bring every editor model and the language server in line with it.
+      window.location.reload()
+    } catch (err) {
+      setMessage(`Format failed: ${errorMessage(err)}`)
+    } finally {
+      setBusy(null)
+    }
+  }
+
+  const openSubmit = () =>
+    modals.open({
+      title: 'Submit for review',
+      size: 'lg',
+      radius: 'xs',
+      children: <SubmitForm getFiles={() => playground.getContext().files} onDone={() => modals.closeAll()} />,
+    })
+
+  const openAbout = () =>
+    modals.open({
+      title: 'About this editor',
+      size: 'md',
+      radius: 'xs',
+      children: <AboutContent />,
+    })
+
+  return (
+    <Group h="100%" px="md" justify="space-between" align="center" wrap="nowrap">
+      <Group gap="md" align="center" wrap="nowrap">
+        <Text fw={700} fz="md">LikeC4 Model Editor</Text>
+        {DEMO
+          ? (
+            <Badge variant="light" color="yellow" tt="none" data-testid="demo-label">
+              Demo – changes are not saved
+            </Badge>
+          )
+          : (
+            <>
+              <Tooltip label="The branch your changes go to" withArrow>
+                <Badge
+                  variant="light"
+                  color="gray"
+                  leftSection={<IconGitBranch size={12} />}
+                  tt="none"
+                  data-testid="branch-indicator">
+                  {branch ?? '...'}
+                </Badge>
+              </Tooltip>
+              <SaveIndicator />
+            </>
+          )}
+      </Group>
+      <Group gap="xs" wrap="nowrap">
+        {message && <Text fz="xs" c="dimmed" data-testid="header-message">{message}</Text>}
+        {DEMO
+          ? (
+            <Button
+              component="a"
+              href="https://github.com/jakos/architecture-as-code"
+              target="_blank"
+              rel="noopener"
+              size="xs"
+              variant="default"
+              leftSection={<IconBrandGithub size={14} />}
+              data-testid="repo-link">
+              Source on GitHub
+            </Button>
+          )
+          : (
+            <>
+              <Button
+                size="xs"
+                variant="default"
+                leftSection={<IconShieldCheck size={14} />}
+                loading={problems.running}
+                onClick={() => void validate()}>
+                Validate
+              </Button>
+              <Button
+                size="xs"
+                variant="default"
+                leftSection={<IconWand size={14} />}
+                loading={busy === 'format'}
+                onClick={() => void format()}>
+                Format
+              </Button>
+              <Button size="xs" leftSection={<IconUpload size={14} />} onClick={openSubmit}>
+                Submit
+              </Button>
+            </>
+          )}
+        <ColorSchemeToggle />
+        <ActionIcon variant="subtle" color="gray" size="md" aria-label="About" onClick={openAbout}>
+          <IconInfoCircle size={18} stroke={1.5} />
+        </ActionIcon>
+      </Group>
+    </Group>
+  )
+}
