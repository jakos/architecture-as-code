+import { Alert, Button, Code, CopyButton, Group, List, Stack, Text, Textarea } from '@mantine/core'
+import { IconAlertCircle, IconCheck } from '@tabler/icons-react'
+import { useEffect, useState } from 'react'
+import { saveAll } from './saving'
+import { errorMessage, server, ServerError, type SubmitPayload } from './server'
+
+/** Pulls the printed `gh pr create ...` line out of the submit output. */
+export function prCommandFrom(output: string): string | null {
+  const line = output.split('\n').find(l => l.trim().startsWith('gh pr create'))
+  return line ? line.trim() : null
+}
+
+/** Rendered inside a Mantine modal, i.e. outside the playground state provider: files come in as a getter. */
+export function SubmitForm({ getFiles, onDone }: { getFiles: () => Record<string, string>; onDone: () => void }) {
+  const [changes, setChanges] = useState<string[] | null>(null)
+  const [branch, setBranch] = useState('')
+  const [message, setMessage] = useState('')
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+  const [result, setResult] = useState<SubmitPayload | null>(null)
+
+  useEffect(() => {
+    // Save first so the list shows what will really be committed.
+    void saveAll(getFiles())
+      .then(() => server.status())
+      .then(s => {
+        setChanges(s.changes)
+        setBranch(s.branch)
+      })
+      .catch(err => setError(errorMessage(err)))
+  }, [])
+
+  const submit = async () => {
+    setBusy(true)
+    setError(null)
+    try {
+      if (!(await saveAll(getFiles()))) {
+        setError('Some files could not be saved, so nothing was submitted. Fix that and try again.')
+        return
+      }
+      setResult(await server.submit(message.trim()))
+    } catch (err) {
+      setError(err instanceof ServerError ? err.message : errorMessage(err))
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  if (result) {
+    const command = prCommandFrom(result.output)
+    return (
+      <Stack gap="sm" data-testid="submit-result">
+        <Alert color="teal" icon={<IconCheck size={16} />} title="Submitted">
+          Your changes are on the branch {branch ? <Code>{branch}</Code> : null}. Open a pull request to get them
+          reviewed.
+        </Alert>
+        {result.skipped.length > 0 && (
+          <Stack gap={4} data-testid="submit-skipped">
+            <Text fz="sm" fw={500}>Not included (only .c4 model files are submitted)</Text>
+            <List size="xs" spacing={2}>
+              {result.skipped.map(path => <List.Item key={path}>{path}</List.Item>)}
+            </List>
+          </Stack>
+        )}
+        {command && (
+          <Stack gap={4}>
+            <Text fz="sm" fw={500}>Command that opens the pull request</Text>
+            <Group gap="xs" wrap="nowrap" align="flex-start">
+              <Code block style={{ flex: 1, whiteSpace: 'pre-wrap' }}>{command}</Code>
+              <CopyButton value={command}>
+                {({ copied, copy }) => (
+                  <Button size="xs" variant="default" onClick={copy}>{copied ? 'Copied' : 'Copy'}</Button>
+                )}
+              </CopyButton>
+            </Group>
+          </Stack>
+        )}
+        <Text fz="sm" fw={500}>Output</Text>
+        <Code block style={{ whiteSpace: 'pre-wrap' }} data-testid="submit-output">{result.output}</Code>
+        <Group justify="flex-end">
+          <Button onClick={onDone}>Close</Button>
+        </Group>
+      </Stack>
+    )
+  }
+
+  return (
+    <Stack gap="sm">
+      <Text fz="sm">
+        Branch: <Code>{branch || '...'}</Code>. Submit checks the model, commits your changed model files and sends
+        them to this branch. It never touches main.
+      </Text>
+      <Stack gap={4}>
+        <Text fz="sm" fw={500}>Changed files</Text>
+        {changes === null && <Text fz="xs" c="dimmed">Loading...</Text>}
+        {changes !== null && changes.length === 0 && <Text fz="xs" c="dimmed">No changes yet.</Text>}
+        {changes !== null && changes.length > 0 && (
+          <List size="xs" spacing={2} data-testid="submit-changes">
+            {changes.map(line => <List.Item key={line}>{line}</List.Item>)}
+          </List>
+        )}
+      </Stack>
+      <Textarea
+        label="Describe your change"
+        description="Becomes the commit message and the pull request title."
+        placeholder="For example: add the notification service"
+        data-autofocus
+        autosize
+        minRows={2}
+        value={message}
+        onChange={e => setMessage(e.currentTarget.value)} />
+      {error && (
+        <Alert color="red" icon={<IconAlertCircle size={16} />} title="Not submitted" data-testid="submit-error">
+          <Code block style={{ whiteSpace: 'pre-wrap' }}>{error}</Code>
+        </Alert>
+      )}
+      <Group justify="flex-end">
+        <Button variant="default" onClick={onDone}>Cancel</Button>
+        <Button loading={busy} onClick={() => void submit()}>Submit for review</Button>
+      </Group>
+    </Stack>
+  )
+}
diff --git a/apps/playground/src/aac/followFile.ts b/apps/playground/src/aac/followFile.ts
new file mode 100644
index 0000000..498a977
--- /dev/null
+++ b/apps/playground/src/aac/followFile.ts
@@ -0,0 +1,139 @@
+import type { ViewId } from '@likec4/core'
+import type { LikeC4Model } from '@likec4/core/model'
+import type { Location } from 'vscode-languageserver-types'
+import { hasLocate, type LocateFn } from './language'
+
+type Position = { file: string; line: number; character: number }
+
+type ViewLike = {
+  readonly id: ViewId
+  readonly $view: { readonly sourcePath?: string | undefined }
+}
+
+const normalize = (path: string) => path.replace(/^\/+/, '')
+
+/** File name (as in the workspace) of a language server location. */
+function fileOf(location: Location): string {
+  return normalize(decodeURIComponent(new URL(location.uri).pathname))
+}
+
+function toPosition(location: Location | null): Position | null {
+  if (!location) return null
+  return { file: fileOf(location), line: location.range.start.line, character: location.range.start.character }
+}
+
+function compare(a: Position, b: Position): number {
+  return a.file.localeCompare(b.file) || a.line - b.line || a.character - b.character
+}
+
+/** Locate that never throws: a failure is logged and counts as "not found". */
+async function tryLocate(locate: LocateFn, target: Parameters<LocateFn>[0]): Promise<Position | null> {
+  try {
+    return toPosition(await locate(target))
+  } catch (error) {
+    console.warn('locate failed', target, error)
+    return null
+  }
+}
+
+/** Views in source order (file, line, character); views that cannot be located come last, in input order. */
+async function inSourceOrder(views: Iterable<ViewLike>, locate: LocateFn): Promise<ViewId[]> {
+  const located = await Promise.all(
+    [...views].map(async (view, index) => ({ id: view.id, index, at: await tryLocate(locate, { view: view.id }) })),
+  )
+  return located
+    .sort((a, b) => {
+      if (a.at && b.at) return compare(a.at, b.at)
+      if (a.at) return -1
+      if (b.at) return 1
+      return a.index - b.index
+    })
+    .map(v => v.id)
+}
+
+/**
+ * The view that belongs to a file, or null to leave the diagram alone.
+ *
+ * 1. A view defined in the file wins (the first one in the file).
+ * 2. Otherwise the elements and deployment nodes defined in the file, outermost first, in
+ *    source order. For each: its first scoped view (`view x of <element>`), then the first view
+ *    that includes it (for a deployment element: the first deployment view).
+ *
+ * Everything comes from the model and the language server; no names are built in.
+ */
+export async function viewForFile(
+  filename: string,
+  model: LikeC4Model.Computed | null,
+  fileText: string | undefined,
+  locate: LocateFn,
+): Promise<ViewId | null> {
+  const file = normalize(filename)
+  if (!model || fileText === undefined || !file.endsWith('.c4')) return null
+
+  // Views defined in the file. sourcePath is relative to the project folder; if it is missing,
+  // ask the language server.
+  const views = [...model.views()]
+  const inFile = await Promise.all(views.map(async view => {
+    const sourcePath = view.$view.sourcePath
+    if (sourcePath) return normalize(sourcePath) === file
+    return (await tryLocate(locate, { view: view.id }))?.file === file
+  }))
+  const defined = views.filter((_, i) => inFile[i])
+  if (defined.length > 0) {
+    return (await inSourceOrder(defined, locate))[0] ?? null
+  }
+
+  // Elements defined in the file. A file cannot define a name it does not contain.
+  type Candidate = {
+    kind: 'element' | 'deployment'
+    id: string
+    parent: string | null
+    at: Position
+    firstView: () => Promise<ViewId | null>
+  }
+  const first = async (candidates: Iterable<ViewLike>) => (await inSourceOrder(candidates, locate))[0] ?? null
+  const found = await Promise.all([
+    ...[...model.elements()]
+      .filter(element => fileText.includes(element.name))
+      .map(async (element): Promise<Candidate | null> => {
+        const at = await tryLocate(locate, { element: element.id })
+        if (at?.file !== file) return null
+        return {
+          kind: 'element',
+          id: element.id,
+          parent: element.parent?.id ?? null,
+          at,
+          firstView: async () => (await first(element.scopedViews())) ?? (await first(element.views())),
+        }
+      }),
+    ...[...model.deployment.elements()]
+      .filter(element => fileText.includes(element.name))
+      .map(async (element): Promise<Candidate | null> => {
+        const at = await tryLocate(locate, { deployment: element.id })
+        if (at?.file !== file) return null
+        return {
+          kind: 'deployment',
+          id: element.id,
+          parent: element.parent?.id ?? null,
+          at,
+          firstView: () => first(element.views()),
+        }
+      }),
+  ])
+  const defining = found.filter((c): c is Candidate => c !== null)
+  console.debug('followFile', {
+    file,
+    hasLocate: hasLocate(),
+    defining: defining.map(c => `${c.id}@${c.at.file}:${c.at.line}`),
+  })
+  // Logical and deployment ids live in separate namespaces.
+  const ids = new Set(defining.map(c => `${c.kind}:${c.id}`))
+  const roots = defining
+    .filter(c => c.parent === null || !ids.has(`${c.kind}:${c.parent}`))
+    .sort((a, b) => compare(a.at, b.at))
+  for (const root of roots) {
+    const view = await root.firstView()
+    if (view) return view
+  }
+  return null
+}
diff --git a/apps/playground/src/aac/language.ts b/apps/playground/src/aac/language.ts
new file mode 100644
index 0000000..afb3e5f
--- /dev/null
+++ b/apps/playground/src/aac/language.ts
@@ -0,0 +1,25 @@
+import type { Locate } from '@likec4/language-server/protocol'
+import type { Location } from 'vscode-languageserver-types'
+
+/** Sends a Locate request to the LikeC4 language server. */
+export type LocateFn = (params: Locate.Params) => Promise<Location | null>
+
+let current: LocateFn | null = null
+
+/**
+ * LanguageClientSync owns the language client. It registers its Locate request here
+ * (and clears it when the client goes away), so that code in src/aac/ can ask where
+ * something is defined.
+ */
+export function setLocate(fn: LocateFn | null) {
+  current = fn
+}
+
+export function hasLocate(): boolean {
+  return current !== null
+}
+
+/** Where the language server says the target is defined; null while no client is registered. */
+export async function locate(params: Locate.Params): Promise<Location | null> {
+  return current ? await current(params) : null
+}
