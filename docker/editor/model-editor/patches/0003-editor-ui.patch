+++ b/apps/playground/src/aac/AacEditorLayout.tsx
@@ -0,0 +1,324 @@
+import { usePlayground, usePlaygroundContext } from '$hooks/usePlayground'
+import {
+  ActionIcon,
+  Badge,
+  Box,
+  Group,
+  HoverCard,
+  NavLink,
+  ScrollArea,
+  Stack,
+  Text,
+  ThemeIcon,
+  Tooltip,
+} from '@mantine/core'
+import { useStore } from '@nanostores/react'
+import {
+  IconAlertCircle,
+  IconAlertTriangle,
+  IconChevronDown,
+  IconChevronRight,
+  IconFile,
+  IconInfoCircle,
+  IconX,
+} from '@tabler/icons-react'
+import { useRouter } from '@tanstack/react-router'
+import { type PropsWithChildren, useEffect, useMemo, useRef } from 'react'
+import { viewForFile } from './followFile'
+import { locate } from './language'
+import { $problems, applyMarkers, dropStaleProblems, revealInEditor } from './problems'
+import { type FileSaveState, type SaveStates, useSaveStates } from './saving'
+import { type Problem } from './server'
+
+type TreeNode = { name: string; path: string; children: TreeNode[]; file: boolean }
+
+/** Builds folders from the slash-separated paths of the model files. */
+export function buildTree(paths: string[]): TreeNode[] {
+  const root: TreeNode = { name: '', path: '', children: [], file: false }
+  for (const path of [...paths].sort()) {
+    const parts = path.split('/')
+    let node = root
+    parts.forEach((name, index) => {
+      const isFile = index === parts.length - 1
+      const fullPath = parts.slice(0, index + 1).join('/')
+      let child = node.children.find(c => c.name === name && c.file === isFile)
+      if (!child) {
+        child = { name, path: fullPath, children: [], file: isFile }
+        node.children.push(child)
+      }
+      node = child
+    })
+  }
+  const order = (nodes: TreeNode[]): TreeNode[] =>
+    nodes
+      .map(n => ({ ...n, children: order(n.children) }))
+      .sort((a, b) => Number(a.file) - Number(b.file) || a.name.localeCompare(b.name))
+  return order(root.children)
+}
+
+const stateColor: Record<FileSaveState, string> = {
+  saved: 'teal',
+  saving: 'blue',
+  unsaved: 'yellow',
+  error: 'red',
+}
+
+const stateLabel: Record<FileSaveState, string> = {
+  saved: 'Saved',
+  saving: 'Saving...',
+  unsaved: 'Unsaved changes',
+  error: 'Not saved',
+}
+
+export function SaveDot({ state, error }: { state: FileSaveState; error?: string | undefined }) {
+  if (state === 'saved') return null
+  return (
+    <Tooltip label={error ? `${stateLabel[state]}: ${error}` : stateLabel[state]} withArrow>
+      <Box
+        data-save-state={state}
+        w={8}
+        h={8}
+        style={{ borderRadius: '50%', background: `var(--mantine-color-${stateColor[state]}-6)` }} />
+    </Tooltip>
+  )
+}
+
+function problemCounts(items: Problem[]) {
+  const counts: Record<string, number> = {}
+  for (const item of items) {
+    if (item.path) counts[item.path] = (counts[item.path] ?? 0) + 1
+  }
+  return counts
+}
+
+function TreeItems({
+  nodes,
+  activeFilename,
+  saveStates,
+  counts,
+  onOpen,
+}: {
+  nodes: TreeNode[]
+  activeFilename: string
+  saveStates: SaveStates
+  counts: Record<string, number>
+  onOpen: (path: string) => void
+}) {
+  return (
+    <>
+      {nodes.map(node => {
+        if (!node.file) {
+          return (
+            <NavLink
+              key={node.path}
+              label={node.name}
+              fz="xs"
+              py={2}
+              defaultOpened
+              childrenOffset={12}
+              rightSection={<IconChevronRight size={12} />}>
+              <TreeItems
+                nodes={node.children}
+                activeFilename={activeFilename}
+                saveStates={saveStates}
+                counts={counts}
+                onOpen={onOpen} />
+            </NavLink>
+          )
+        }
+        const state = saveStates.byFile[node.path] ?? 'saved'
+        const problemCount = counts[node.path] ?? 0
+        return (
+          <NavLink
+            key={node.path}
+            label={node.name}
+            title={node.path}
+            fz="xs"
+            py={2}
+            active={node.path === activeFilename}
+            leftSection={<IconFile size={14} />}
+            rightSection={
+              <Group gap={6} wrap="nowrap">
+                {problemCount > 0 && <Badge size="xs" color="red" variant="light">{problemCount}</Badge>}
+                <SaveDot state={state} error={saveStates.errors[node.path]} />
+              </Group>
+            }
+            onClick={() => onOpen(node.path)} />
+        )
+      })}
+    </>
+  )
+}
+
+function FileTree() {
+  const playground = usePlayground()
+  const router = useRouter()
+  const latestClick = useRef(0)
+  const files = usePlaygroundContext(s => s.files)
+  const activeFilename = usePlaygroundContext(s => s.activeFilename)
+  const saveStates = useSaveStates(files)
+  const problems = useStore($problems)
+  const tree = useMemo(() => buildTree(Object.keys(files)), [Object.keys(files).join('\n')])
+  const counts = useMemo(() => problemCounts(problems.items), [problems.items])
+
+  useEffect(() => {
+    dropStaleProblems(files)
+  }, [files])
+
+  return (
+    <ScrollArea h="100%" type="auto" data-testid="file-tree">
+      <Text fz={10} fw={600} c="dimmed" px="xs" pt={6} pb={2} tt="uppercase">Model files</Text>
+      <TreeItems
+        nodes={tree}
+        activeFilename={activeFilename}
+        saveStates={saveStates}
+        counts={counts}
+        onOpen={path => {
+          revealInEditor(path, null)
+          playground.changeActiveFile(path)
+          // Show the file's view. Only a tree click does this; a newer click drops an older result.
+          const click = ++latestClick.current
+          const { likec4model, files } = playground.getContext()
+          viewForFile(path, likec4model, files[path], locate)
+            .then(viewId => {
+              if (click !== latestClick.current || !viewId) return
+              // Same two steps as the "open preview" code lens: URL and diagram agree.
+              void router.navigate({
+                from: '/w/$workspaceId/$viewId',
+                to: './',
+                params: { viewId },
+              })
+              playground.changeActiveView(viewId)
+            })
+            .catch(error => console.error('could not follow file to its view', error))
+        }} />
+    </ScrollArea>
+  )
+}
+
+function OpenFileBar() {
+  const files = usePlaygroundContext(s => s.files)
+  const activeFilename = usePlaygroundContext(s => s.activeFilename)
+  const diagnosticErrors = usePlaygroundContext(s => s.diagnosticErrors)
+  const saveStates = useSaveStates(files)
+  const state = saveStates.byFile[activeFilename] ?? 'saved'
+  return (
+    <Group h={30} px="xs" gap="xs" justify="space-between" wrap="nowrap" style={{ flexShrink: 0 }}>
+      <Group gap={8} wrap="nowrap">
+        <Text fz="xs" fw={500} truncate>{activeFilename}</Text>
+        <Badge size="xs" variant="light" tt="none" color={stateColor[state]} data-testid="file-save-state">
+          {stateLabel[state]}
+        </Badge>
+      </Group>
+      {diagnosticErrors.length > 0 && (
+        <HoverCard position="bottom-end">
+          <HoverCard.Target>
+            <ThemeIcon color="red" size="sm" radius="sm">
+              <IconAlertTriangle size={14} />
+            </ThemeIcon>
+          </HoverCard.Target>
+          <HoverCard.Dropdown p="xs" maw={480}>
+            <Stack gap={4}>
+              {diagnosticErrors.map((error, i) => <Text component="div" c="red.7" key={i} fz="sm">{error}</Text>)}
+            </Stack>
+          </HoverCard.Dropdown>
+        </HoverCard>
+      )}
+    </Group>
+  )
+}
+
+function ProblemsPanel() {
+  const playground = usePlayground()
+  const state = useStore($problems)
+  if (state.ok === null && !state.failure) return null
+
+  const open = state.open
+  const toggle = () => $problems.set({ ...state, open: !open })
+  const count = state.items.length
+  return (
+    <Box
+      data-testid="problems-panel"
+      style={{ flexShrink: 0, borderTop: '1px solid var(--mantine-color-default-border)' }}>
+      <Group h={28} px="xs" justify="space-between" onClick={toggle} style={{ cursor: 'pointer' }}>
+        <Group gap={6}>
+          {open ? <IconChevronDown size={14} /> : <IconChevronRight size={14} />}
+          <Text fz="xs" fw={600}>Problems</Text>
+          <Badge size="xs" color={count > 0 ? 'red' : 'teal'} variant="light">{count}</Badge>
+        </Group>
+        <ActionIcon
+          size="xs"
+          variant="subtle"
+          color="gray"
+          aria-label="Clear problems"
+          onClick={e => {
+            e.stopPropagation()
+            $problems.set({ ...state, items: [], ok: null, failure: null, open: false })
+            applyMarkers([])
+          }}>
+          <IconX size={12} />
+        </ActionIcon>
+      </Group>
+      {open && (
+        <ScrollArea.Autosize mah={180} type="auto">
+          <Stack gap={0} pb={4}>
+            {state.failure && (
+              <Group px="xs" py={2} gap={6} wrap="nowrap">
+                <IconAlertCircle size={14} color="var(--mantine-color-red-6)" />
+                <Text fz="xs" c="red">{state.failure}</Text>
+              </Group>
+            )}
+            {!state.failure && count === 0 && (
+              <Group px="xs" py={2} gap={6}>
+                <IconInfoCircle size={14} />
+                <Text fz="xs" c="dimmed">No problems found.</Text>
+              </Group>
+            )}
+            {state.items.map((problem, i) => (
+              <Group
+                key={i}
+                px="xs"
+                py={2}
+                gap={6}
+                wrap="nowrap"
+                align="flex-start"
+                data-testid="problem-row"
+                style={{ cursor: problem.path ? 'pointer' : 'default' }}
+                onClick={() => {
+                  if (!problem.path) return
+                  revealInEditor(problem.path, problem.line)
+                  playground.changeActiveFile(problem.path)
+                }}>
+                <IconAlertCircle
+                  size={14}
+                  style={{ flexShrink: 0, marginTop: 2 }}
+                  color={`var(--mantine-color-${problem.severity === 'error' ? 'red' : 'yellow'}-6)`} />
+                <Text fz="xs" style={{ whiteSpace: 'pre-wrap' }}>
+                  {problem.path ? <b>{problem.path}{problem.line ? `:${problem.line}` : ''}</b> : null}
+                  {problem.path ? '  ' : ''}
+                  {problem.message}
+                </Text>
+              </Group>
+            ))}
+          </Stack>
+        </ScrollArea.Autosize>
+      )}
+    </Box>
+  )
+}
+
+/** File tree on the left, the editor (children) with its file bar and problems list on the right. */
+export function AacEditorLayout({ children }: PropsWithChildren) {
+  return (
+    <Group h="100%" gap={0} wrap="nowrap" align="stretch">
+      <Box w={230} style={{ flexShrink: 0, borderRight: '1px solid var(--mantine-color-default-border)' }}>
+        <FileTree />
+      </Box>
+      <Stack flex={1} gap={0} style={{ minWidth: 0 }}>
+        <OpenFileBar />
+        <Stack flex={1} gap={0} style={{ minHeight: 0 }}>{children}</Stack>
+        <ProblemsPanel />
+      </Stack>
+    </Group>
+  )
+}
