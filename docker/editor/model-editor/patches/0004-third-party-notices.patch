+// Records which source files went into the browser bundles (the app and its web workers), for
+// the generated THIRD-PARTY-NOTICES.txt (tools/third_party_notices.py). One JSON list of module
+// ids per bundle goes to dist/bundled-modules/. The Cloudflare Worker environment is not shipped.
+const bundledModules = (): Plugin => ({
+  name: 'aac-bundled-modules',
+  apply: 'build',
+  async generateBundle(_options, bundle) {
+    if (this.environment?.name === 'playground') return
+    const ids = new Set<string>()
+    for (const item of Object.values(bundle)) {
+      if (item.type === 'chunk') {
+        for (const [id, info] of Object.entries(item.modules)) {
+          if ((info.renderedLength ?? 1) > 0) ids.add(id)
+        }
+      } else {
+        for (const name of item.originalFileNames ?? []) ids.add(resolve(name))
+      }
+    }
+    const dir = url.fileURLToPath(new URL('./dist/bundled-modules', import.meta.url))
+    await mkdir(dir, { recursive: true })
+    const file = `${this.environment?.name ?? 'build'}-${randomUUID()}.json`
+    await writeFile(resolve(dir, file), JSON.stringify([...ids].sort()))
+  },
+})
