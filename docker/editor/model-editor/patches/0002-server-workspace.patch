@@ -0,0 +1,102 @@
+/**
+ * Client for the model editor server (tools/web_editor.py).
+ *
+ * Same origin only: the browser sends its own Basic auth credentials, this code never sees
+ * or stores the password.
+ *
+ * In the demo build (see mode.ts) there is no server: `server` is replaced by a stand-in that
+ * reads the static workspace.json and refuses everything else, and the server calls below are
+ * not part of the bundle.
+ */
+
+import { DEMO } from './mode'
+
+export type Problem = {
+  /** Path relative to the model directory, or null when the tool output has no file. */
+  path: string | null
+  line: number | null
+  column: number | null
+  severity: 'error' | 'warning' | 'info'
+  message: string
+}
+
+export type ToolResult = { command: string; exit: number; output: string }
+
+export type WorkspacePayload = { branch: string; files: Record<string, string> }
+export type StatusPayload = { branch: string; changes: string[] }
+export type ValidatePayload = { ok: boolean; results: ToolResult[]; problems: Problem[] }
+export type FormatPayload = { ok: boolean; results: ToolResult[]; changed: string[] }
+export type SubmitPayload = { ok: boolean; output: string; skipped: string[] }
+
+export class ServerError extends Error {
+  readonly status: number
+  constructor(status: number, message: string) {
+    super(message)
+    this.name = 'ServerError'
+    this.status = status
+  }
+}
+
+async function call<T>(method: string, url: string, body?: unknown): Promise<T> {
+  const init: RequestInit = { method, credentials: 'same-origin', cache: 'no-store' }
+  if (body !== undefined) {
+    init.headers = { 'Content-Type': 'application/json' }
+    init.body = JSON.stringify(body)
+  }
+  let response: Response
+  try {
+    response = await fetch(url, init)
+  } catch (err) {
+    throw new ServerError(0, `The editor server is not reachable (${String(err)})`)
+  }
+  let data: any = null
+  try {
+    data = await response.json()
+  } catch {
+    // not JSON: the status text below is all we have
+  }
+  if (!response.ok) {
+    throw new ServerError(response.status, data?.error ?? response.statusText)
+  }
+  return data as T
+}
+
+const serverApi = {
+  workspace: () => call<WorkspacePayload>('GET', '/api/workspace'),
+  status: () => call<StatusPayload>('GET', '/api/status'),
+  saveFile: (path: string, text: string) =>
+    call<{ ok: boolean }>('PUT', `/api/file?path=${encodeURIComponent(path)}`, { text }),
+  validate: () => call<ValidatePayload>('POST', '/api/validate', {}),
+  format: () => call<FormatPayload>('POST', '/api/format', {}),
+  submit: (message: string) => call<SubmitPayload>('POST', '/api/submit', { message }),
+}
+
+const unavailable = (): Promise<never> =>
+  Promise.reject(new ServerError(0, 'Not available in the demo'))
+
+/** The demo has no server: the workspace is the static file next to index.html, nothing else. */
+const demoApi: typeof serverApi = {
+  workspace: async () => {
+    const response = await fetch(`${import.meta.env.BASE_URL}workspace.json`, { cache: 'no-store' })
+    if (!response.ok) throw new ServerError(response.status, 'The demo workspace could not be loaded')
+    const data = await response.json()
+    return { branch: '', files: data.files as Record<string, string> }
+  },
+  status: unavailable,
+  saveFile: unavailable,
+  validate: unavailable,
+  format: unavailable,
+  submit: unavailable,
+}
+
+export const server: typeof serverApi = DEMO ? demoApi : serverApi
+
+/** The model's files: from the editor server, or from workspace.json in the demo. */
+export async function loadWorkspace(): Promise<{ files: Record<string, string> }> {
+  const { files } = await server.workspace()
+  return { files }
+}
+
+export function errorMessage(err: unknown): string {
+  return err instanceof Error ? err.message : String(err)
+}
