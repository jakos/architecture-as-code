index 0000000..40aace0
--- /dev/null
+++ b/apps/playground/src/aac/saving.ts
@@ -0,0 +1,118 @@
+import { useStore } from '@nanostores/react'
+import { atom } from 'nanostores'
+import { useMemo } from 'react'
+import { DEMO } from './mode'
+import { errorMessage, server } from './server'
+
+export type FileSaveState = 'saved' | 'saving' | 'unsaved' | 'error'
+
+type SaveInfo = {
+  /** Text the server is known to hold, per file. */
+  saved: Record<string, string>
+  inflight: string[]
+  errors: Record<string, string>
+}
+
+export const $saveInfo = atom<SaveInfo>({ saved: {}, inflight: [], errors: {} })
+
+const ACTIVE_FILE_KEY = 'aac:active-file'
+
+export function initSaved(files: Record<string, string>) {
+  $saveInfo.set({ saved: { ...files }, inflight: [], errors: {} })
+}
+
+/** Remembers only the name of the open file (never model text) across a reload. */
+export function rememberActiveFile(filename: string) {
+  try {
+    sessionStorage.setItem(ACTIVE_FILE_KEY, filename)
+  } catch {
+    // storage may be unavailable; the first file is opened then
+  }
+}
+
+export function recallActiveFile(): string | null {
+  try {
+    return sessionStorage.getItem(ACTIVE_FILE_KEY)
+  } catch {
+    return null
+  }
+}
+
+export function dirtyFiles(files: Record<string, string>, saved = $saveInfo.get().saved): string[] {
+  return Object.keys(files).filter(rel => files[rel] !== saved[rel])
+}
+
+let chain: Promise<unknown> = Promise.resolve()
+
+async function saveDirty(files: Record<string, string>): Promise<boolean> {
+  let allSaved = true
+  for (const rel of dirtyFiles(files)) {
+    const text = files[rel]!
+    const before = $saveInfo.get()
+    $saveInfo.set({ ...before, inflight: [...before.inflight, rel] })
+    try {
+      await server.saveFile(rel, text)
+      const now = $saveInfo.get()
+      const { [rel]: _dropped, ...errors } = now.errors
+      $saveInfo.set({
+        saved: { ...now.saved, [rel]: text },
+        inflight: now.inflight.filter(f => f !== rel),
+        errors,
+      })
+    } catch (err) {
+      allSaved = false
+      const now = $saveInfo.get()
+      // The text stays in the editor and in the workspace state: nothing is lost on failure.
+      $saveInfo.set({
+        ...now,
+        inflight: now.inflight.filter(f => f !== rel),
+        errors: { ...now.errors, [rel]: errorMessage(err) },
+      })
+    }
+  }
+  return allSaved
+}
+
+/**
+ * Writes every changed file to the server, one request at a time. Resolves true if all were saved.
+ * In the demo nothing is written anywhere: it resolves true without a request.
+ */
+export function saveAll(files: Record<string, string>): Promise<boolean> {
+  if (DEMO) return Promise.resolve(true)
+  const run = chain.then(() => saveDirty(files))
+  chain = run.catch(() => undefined)
+  return run
+}
+
+/** Called by the playground state machine in place of the localStorage write. */
+export function persistWorkspace(context: { files: Record<string, string>; activeFilename: string }) {
+  rememberActiveFile(context.activeFilename)
+  if (DEMO) return // the demo keeps the text in memory only
+  void saveAll(context.files)
+}
+
+export type SaveStates = {
+  byFile: Record<string, FileSaveState>
+  errors: Record<string, string>
+  overall: FileSaveState
+}
+
+export function computeSaveStates(files: Record<string, string>, info: SaveInfo): SaveStates {
+  const byFile: Record<string, FileSaveState> = {}
+  let overall: FileSaveState = 'saved'
+  const rank: Record<FileSaveState, number> = { saved: 0, unsaved: 1, saving: 2, error: 3 }
+  for (const rel of Object.keys(files)) {
+    let state: FileSaveState = 'saved'
+    if (info.errors[rel]) state = 'error'
+    else if (info.inflight.includes(rel)) state = 'saving'
+    else if (files[rel] !== info.saved[rel]) state = 'unsaved'
+    byFile[rel] = state
+    if (rank[state] > rank[overall]) overall = state
+  }
+  return { byFile, errors: info.errors, overall }
+}
+
+export function useSaveStates(files: Record<string, string>): SaveStates {
+  const info = useStore($saveInfo)
+  return useMemo(() => computeSaveStates(files, info), [files, info])
+}
