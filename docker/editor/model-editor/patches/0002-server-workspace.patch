+/**
+ * Demo mode: a static build of the editor (`vite build --mode demo`) that has no server.
+ *
+ * The model is read from a `workspace.json` next to index.html, edits stay in memory and are
+ * never saved. Server mode (the normal build, mode `production`) is the default. The check is
+ * a build-time constant, so the demo bundle holds none of the server API calls.
+ */
+export const DEMO = import.meta.env.MODE === 'demo'
diff --git a/apps/playground/src/aac/saving.ts b/apps/playground/src/aac/saving.ts
