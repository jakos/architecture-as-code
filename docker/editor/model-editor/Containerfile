# LikeC4 Model Editor: "Edit a LikeC4 architecture model in the browser and propose changes for
# review, no git knowledge needed." The LikeC4 playground at a pinned tag plus our patch set,
# served by tools/web_editor.py on a git clone.
# Community project based on LikeC4, not affiliated with it.
# Build from the repo root: just model-editor-build (needs network access to GitHub and npm; takes
# several minutes).
#
# Version: the image has its own version (semantic versioning), passed as --build-arg
# IMAGE_VERSION=X.Y.Z by the release workflow (.github/workflows/editor-image.yml); a plain
# build is labelled "dev". The LikeC4 version it is built on is the label
# io.github.jakos.architecture-as-code.likec4-version, not the image version.
#
# Build stage: clone the tag, check the commit, install the locked dependencies, apply
# docker/editor/model-editor/patches in order (the build fails if one does not apply), build and
# typecheck apps/playground. The install comes before the patches so that a patch edit does not
# redo it (the patches change no dependency). The playground's Cloudflare Worker (share links,
# GitHub login) is not built and no patch calls it.
# demo-build / demo stages (just editor-demo-app): the same patched source, built again in the
# Vite mode `demo` under the Pages sub-path (DEMO_BASE). They start from `build`, so the commit
# check and the patches are not repeated. The result is a static app without server code; the
# model comes from a workspace.json that tools/editor_demo.py adds next to index.html.
# Runtime stage (last, so a plain build gives the image): Node (for the likec4 CLI that
# validates and formats), Python and git (for the server and submit), and the built static app. No password or token is baked in.
#
# Based on LikeC4 (https://likec4.dev), MIT licence, Copyright (c) 2023-2026 Denis Davydkov.
# The licence text is copied into the image (see the About entry in the editor).
# Licences: LikeC4 MIT; Node.js MIT; the patches, web_editor.py and submit.py are this repo's code
# (MIT). Both licence texts are in the image: LICENSE-LikeC4.txt and LICENSE.txt.

# The LikeC4 pin, in one place (global scope so that the runtime stage can label it).
ARG LIKEC4_TAG=v1.59.4
ARG LIKEC4_COMMIT=33dbc2d34c399a99daf96e92fc28fe5d280a7fd5

FROM docker.io/library/node:22.22.3-trixie-slim AS build
# apt packages are not version-pinned: they come from the Debian trixie archive at build time.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates python3 make g++ \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm@11.25.0
WORKDIR /src
ARG LIKEC4_TAG
ARG LIKEC4_COMMIT
RUN git clone --depth 1 --branch "${LIKEC4_TAG}" https://github.com/likec4/likec4.git . \
    && actual="$(git rev-parse HEAD)" \
    && echo "LikeC4 ${LIKEC4_TAG} is commit ${actual}" \
    && test "${actual}" = "${LIKEC4_COMMIT}"
RUN pnpm install --frozen-lockfile --filter '@likec4/playground...'
COPY docker/editor/model-editor/patches/ /patches/
RUN set -e; \
    for patch in /patches/*.patch; do \
        git apply --check "${patch}"; \
        git apply "${patch}"; \
        echo "applied $(basename "${patch}")"; \
    done
WORKDIR /src/apps/playground
RUN CI=1 pnpm exec turbo run build --ui=stream
# The playground's own typecheck, over upstream code and our patches together.
RUN pnpm run typecheck

# Static demo build. Run after turbo (above) has produced the dependencies and generated files;
# `vite build` is called directly because turbo filters environment variables.
FROM build AS demo-build
ARG DEMO_BASE=/architecture-as-code/editor/
WORKDIR /src/apps/playground
RUN pnpm exec vite build --mode demo --base "${DEMO_BASE}" \
    && mkdir /demo \
    && cp -r dist/client/. /demo/ \
    && cp /src/LICENSE /demo/LICENSE-LikeC4.txt
COPY LICENSE /demo/LICENSE.txt

FROM scratch AS demo
COPY --from=demo-build /demo /demo

FROM docker.io/library/node:22.22.3-trixie-slim
# apt packages are not version-pinned: they come from the Debian trixie archive at build time.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 git \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g likec4@1.59.4 \
    && usermod -l coder -d /home/coder -m node \
    && groupmod -n coder node
# The base image's `node` user has uid 1000; it is renamed so paths match the other editor images.

COPY --from=build /src/apps/playground/dist/client /usr/local/share/model-editor
COPY --from=build /src/LICENSE /usr/local/share/model-editor/LICENSE-LikeC4.txt
COPY LICENSE /usr/local/share/model-editor/LICENSE.txt
COPY tools/submit.py tools/model_source.py tools/web_editor.py tools/poc_remote.py \
     docker/editor/entrypoint.py /usr/local/lib/poc/

USER coder
WORKDIR /home/coder
# No password or token here: PASSWORD comes from the environment at run time.
ENV RENDERER=likec4 MODEL_PATH=examples/shop EDITOR_UI=playground
EXPOSE 8080
ENTRYPOINT ["python3", "/usr/local/lib/poc/entrypoint.py"]

ARG LIKEC4_TAG
ARG IMAGE_VERSION=dev
# Podman (Buildah) reuses a cached LABEL layer when only a build-arg changed; a RUN that names
# the argument has the value in its cache key, so a new IMAGE_VERSION always reaches the labels.
RUN echo "image version: ${IMAGE_VERSION}"
LABEL org.opencontainers.image.title="LikeC4 Model Editor" \
      org.opencontainers.image.description="Edit a LikeC4 architecture model in the browser and propose changes for review, no git knowledge needed. Community project based on LikeC4 ${LIKEC4_TAG} (https://likec4.dev), not affiliated with it." \
      org.opencontainers.image.source="https://github.com/jakos/architecture-as-code" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      io.github.jakos.architecture-as-code.likec4-version="${LIKEC4_TAG#v}"
